DATABASE_URL="postgresql://ecash_app:CHANGE_ME@localhost:5432/ecash_petrogabon?schema=public"
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"
JWT_POMPISTE_SECRET="CHANGE_ME"
PORT=3001
# Clé partagée avec l'application client EKALI (GET /integrations/ekali/disponibilite).
# 32 caractères minimum ; vide = intégration désactivée (503). Même valeur que
# ECASH_API_KEY côté EKALI. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EKALI_API_KEY=""
