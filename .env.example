DATABASE_URL="postgresql://ecash_app:CHANGE_ME@localhost:5432/ecash_petrogabon?schema=public"
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"
JWT_POMPISTE_SECRET="CHANGE_ME"
PORT=3001
# Secret partagé avec le serveur Next.js (même valeur que INTERNAL_PROXY_SECRET côté ecash-app),
# 32 caractères minimum : permet à l'API de connaître la vraie IP du client pour la limite de
# tentatives de connexion. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_PROXY_SECRET=""
# Nombre de proxys de confiance devant l'API (1 = frontal Azure App Service).
TRUST_PROXY_HOPS=1
# Clé partagée avec l'application client EKALI (GET /integrations/ekali/disponibilite).
# 32 caractères minimum ; vide = intégration désactivée (503). Même valeur que
# ECASH_API_KEY côté EKALI. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EKALI_API_KEY=""
