generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMINISTRATEUR
  TRESORERIE
  CONTROLE_INTERNE
  GERANTE
  RESEAU
  GRC
}

enum Quart {
  MATIN
  SOIR
  NUIT
}

enum StatutCompte {
  ACTIF
  INACTIF
}

enum StatutPompiste {
  ACTIF
  INACTIF
}

enum StatutStation {
  EN_SERVICE
  HORS_SERVICE
}

enum StatutBanque {
  ACTIF
  INACTIF
}

enum DenominationType {
  BILLET
  PIECE
}

enum Produit {
  ESSENCE
  GASOIL
  PETROLE
}

// Produits suivis par le Stock Carburant / l'Approvisionnement — distinct de Produit (celui
// des pompes, uniquement carburant liquide) car ce module couvre aussi les bouteilles Gaz.
enum ProduitStock {
  ESSENCE
  GASOIL
  PETROLE
  GPL_12_5
  GPL_35
}

// EN_COURS : commande envoyée par la gérante, pas encore traitée. TRAITEE : le GRC a traité la
// demande (ex. commande passée auprès du fournisseur) — ne signifie PAS que le produit est arrivé
// à la station. LIVREE : la gérante confirme la réception physique à sa station — seul ce passage
// compte comme réception de stock (voir StockService.calculerStock).
enum StatutCommande {
  EN_COURS
  TRAITEE
  LIVREE
}

enum StatutPompe {
  ACTIF
  INACTIF
}

// Mode de paiement d'une vente Gaz : la plupart sont payées cash, mais une vente TPE-Gaz est
// possible (paiement carte). Détermine si le montant s'ajoute au Cash Physique ou au TPE du quart.
enum ModePaiement {
  CASH
  TPE
}

// Un quart commence EN_COURS (pompistes + index d'ouverture connus) : le
// pompiste peut y adosser plusieurs remises en caisse pendant le service.
// Il passe à CLOTURE quand la gérante saisit les index de fermeture réels
// et le reste des données du quart (billetage, TPE, GPL).
enum StatutQuart {
  EN_COURS
  CLOTURE
}

enum CategorieAudit {
  CONNEXION
  ENCAISSEMENT
  VERSEMENT
  UTILISATEUR
  STATION
  BANQUE
  POMPISTE
  STOCK
  COMMANDE
}

// ── Auth / RBAC ──────────────────────────────────────────────

model User {
  id                  String       @id @default(cuid())
  identifiant         String       @unique
  email               String       @unique
  passwordHash        String
  prenom              String
  nom                 String
  telephone           String?
  role                Role
  statut              StatutCompte @default(ACTIF)
  stationId           String?
  station             Station?     @relation(fields: [stationId], references: [id])
  mustChangePassword  Boolean      @default(false)
  derniereConnexion   DateTime?
  // Verrouillage temporaire après plusieurs échecs de connexion consécutifs (cf.
  // AuthService.login) — protège contre le brute-force distribué sur un compte
  // précis, que le débit-limitage par IP (@Throttle sur /auth/login) ne couvre pas.
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  refreshTokens RefreshToken[]
  deposits      Deposit[] @relation("DepositsCrees")
  depositsCertifies   Deposit[] @relation("DepositsCertifies")
  jaugeages          Jaugeage[]
  commandesCreees    Commande[] @relation("CommandesCreees")
  commandesTraitees  Commande[] @relation("CommandesTraitees")
  commandesLivrees   Commande[] @relation("CommandesLivrees")
  commandesApprouvees Commande[] @relation("CommandesApprouvees")
  prixModifies        PriceHistory[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Référentiel ──────────────────────────────────────────────

model Station {
  id      String        @id @default(cuid())
  code    String        @unique
  nom     String
  ville   String
  adresse String
  statut  StatutStation @default(EN_SERVICE)

  quartMatinDebut String @default("06:00")
  quartMatinFin   String @default("14:00")
  quartSoirDebut  String @default("14:00")
  quartSoirFin    String @default("22:00")
  quartNuitDebut  String @default("22:00")
  quartNuitFin    String @default("06:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  attendants    Attendant[]
  pumps         Pump[]
  distributeurs Distributeur[]
  cashEntries   CashEntry[]
  deposits      Deposit[]
  auditLogs     AuditLog[]
  jaugeages     Jaugeage[]
  commandes     Commande[]
  seuilsStock   SeuilStock[]

  @@map("stations")
}

// Îlot physique regroupant plusieurs pompes (généralement jusqu'à 4 : essence,
// gasoil, pétrole). Affecter un distributeur à un pompiste à l'ouverture d'un
// quart lui assigne d'un coup toutes les pompes actives de ce distributeur.
model Distributeur {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pumps Pump[]

  @@unique([stationId, nom])
  @@index([stationId])
  @@map("distributeurs")
}

model Attendant {
  id        String         @id @default(cuid())
  nom       String
  prenom    String
  telephone String
  embauche  DateTime
  // Quart habituel/par défaut, purement informatif : l'affectation réelle à un quart donné se
  // fait à l'ouverture de ce quart (CashEntry/PumpReading) et n'est plus contrainte à cette
  // valeur — un pompiste peut être créé sans quart puis affecté librement, du moment qu'il n'est
  // affecté qu'à un seul quart par jour (cf. CashEntriesService.create).
  quart     Quart?
  statut    StatutPompiste @default(ACTIF)
  // Accès à l'espace pompiste (auto-déclaration des remises/ventes Gaz) : un code PIN
  // court, distinct du système de comptes Utilisateur — voir PompisteAuthModule.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  stationId String
  station   Station        @relation(fields: [stationId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  pumpReadings         PumpReading[]
  quartsResponsable    CashEntry[]        @relation("ResponsableQuart")
  quartsResponsableGpl CashEntry[]        @relation("ResponsableGpl")
  versements           VersementProduit[]

  @@index([stationId])
  @@map("attendants")
}

// ── Prix réseau (carburant + GPL, un seul enregistrement, identique
// pour toutes les stations — configuré par l'Admin) ───────────────

model PriceConfig {
  id String @id @default(cuid())

  prixLitreEssence Decimal @default(750) @db.Decimal(10, 2)
  prixLitreGasoil  Decimal @default(700) @db.Decimal(10, 2)
  prixLitrePetrole Decimal @default(650) @db.Decimal(10, 2)

  prixGpl125Pleine           Decimal @default(6000) @db.Decimal(10, 2)
  prixGpl125Consigne         Decimal @default(4500) @db.Decimal(10, 2)
  prixGpl125ConsigneRecharge Decimal @default(1500) @db.Decimal(10, 2)
  prixGpl35Pleine            Decimal @default(15000) @db.Decimal(10, 2)
  prixGpl35Consigne          Decimal @default(11000) @db.Decimal(10, 2)
  prixGpl35ConsigneRecharge  Decimal @default(4000) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  @@map("price_config")
}

// Historique des prix réseau — une ligne par changement, snapshot complet des 9 prix APRÈS
// fusion (voir PricesService.update). Permet de reconstruire "quel était le prix en vigueur à
// telle date" (le plus récent effectiveFrom <= date demandée), ce que le singleton PriceConfig
// seul ne permet pas. L'historique ne commence qu'à partir de l'ajout de ce modèle — les
// changements antérieurs restent uniquement dans le texte libre du Journal d'Audit.
model PriceHistory {
  id String @id @default(cuid())

  prixLitreEssence Decimal @db.Decimal(10, 2)
  prixLitreGasoil  Decimal @db.Decimal(10, 2)
  prixLitrePetrole Decimal @db.Decimal(10, 2)

  prixGpl125Pleine           Decimal @db.Decimal(10, 2)
  prixGpl125Consigne         Decimal @db.Decimal(10, 2)
  prixGpl125ConsigneRecharge Decimal @db.Decimal(10, 2)
  prixGpl35Pleine            Decimal @db.Decimal(10, 2)
  prixGpl35Consigne          Decimal @db.Decimal(10, 2)
  prixGpl35ConsigneRecharge  Decimal @db.Decimal(10, 2)

  changeParUserId String?
  changeParUser   User?    @relation(fields: [changeParUserId], references: [id])
  effectiveFrom   DateTime @default(now())

  @@index([effectiveFrom])
  @@map("price_history")
}

model Bank {
  id      String       @id @default(cuid())
  code    String       @unique
  nom     String
  type    String
  swift   String
  contact String
  statut  StatutBanque @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]

  @@map("banks")
}

// ── Pompes ────────────────────────────────────────────────────

model Pump {
  id             String       @id @default(cuid())
  stationId      String
  station        Station      @relation(fields: [stationId], references: [id])
  distributeurId String
  distributeur   Distributeur @relation(fields: [distributeurId], references: [id])
  code           String
  produit        Produit
  statut         StatutPompe  @default(ACTIF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pumpReadings PumpReading[]

  @@unique([stationId, code])
  @@index([distributeurId])
  @@index([stationId])
  @@map("pumps")
}

// ── Encaissements (un enregistrement par quart, station et date) ─

model CashEntry {
  id        String      @id @default(cuid())
  stationId String
  station   Station     @relation(fields: [stationId], references: [id])
  quart     Quart
  date      DateTime    @default(now())
  statut    StatutQuart @default(EN_COURS)

  responsableQuartId String
  responsableQuart   Attendant @relation("ResponsableQuart", fields: [responsableQuartId], references: [id])
  responsableGplId   String
  responsableGpl     Attendant @relation("ResponsableGpl", fields: [responsableGplId], references: [id])

  // Tous les champs financiers ci-dessous valent 0 tant que statut = EN_COURS
  // (aucun versement n'est encore agrégé) — ils sont figés à la clôture du
  // quart, à partir de la somme des remises et des VersementProduit reçus
  // pendant le quart (voir CashEntriesService.cloturer).
  // totalBillets/totalPieces : comptage optionnel de vérification saisi par la
  // gérante à la clôture (Denomination) — n'alimente plus `montant`, seulement
  // une alerte si la somme diffère de `montant`.
  totalBillets Decimal @default(0) @db.Decimal(14, 2)
  totalPieces  Decimal @default(0) @db.Decimal(14, 2)
  montant      Decimal @default(0) @db.Decimal(14, 2) // cash physique = somme des remises en caisse reçues pendant le quart

  montantTpe    Decimal @default(0) @db.Decimal(14, 2) // ventes carte (TPE), déjà bancarisées, jamais physiques
  montantGlobal Decimal @default(0) @db.Decimal(14, 2) // montant + montantTpe (le Gaz y est déjà inclus selon son mode de paiement) — sert de référence pour l'écart

  quantiteGpl125Pleine           Int     @default(0)
  quantiteGpl125Consigne         Int     @default(0)
  quantiteGpl125ConsigneRecharge Int     @default(0)
  quantiteGpl35Pleine            Int     @default(0)
  quantiteGpl35Consigne          Int     @default(0)
  quantiteGpl35ConsigneRecharge  Int     @default(0)
  montantGpl                     Decimal @default(0) @db.Decimal(14, 2)

  montantCarburant Decimal @default(0) @db.Decimal(14, 2)
  ecart            Decimal @default(0) @db.Decimal(14, 2)

  denominations Denomination[]
  pumpReadings  PumpReading[]
  versements    VersementProduit[]

  @@unique([stationId, quart, date])
  @@index([stationId, date])
  @@map("cash_entries")
}

model Denomination {
  id            String           @id @default(cuid())
  cashEntryId   String
  cashEntry     CashEntry        @relation(fields: [cashEntryId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("denominations")
}

model PumpReading {
  id             String    @id @default(cuid())
  cashEntryId    String
  cashEntry      CashEntry @relation(fields: [cashEntryId], references: [id])
  attendantId    String
  attendant      Attendant @relation(fields: [attendantId], references: [id])
  pumpId         String
  pump           Pump      @relation(fields: [pumpId], references: [id])
  indexOuverture Decimal   @db.Decimal(12, 2)
  // Estimation vivante = indexOuverture + Σ(litres correspondant au cash ET au TPE de chaque
  // remise déjà enregistrée — un client qui paie par carte fait aussi tourner le compteur) —
  // mise à jour à chaque remise, tant que le quart est EN_COURS.
  indexCourant   Decimal?  @db.Decimal(12, 2)
  // Relevé réel du compteur, saisi par la gérante à la clôture du quart —
  // seule valeur qui sert au calcul financier final (peut différer légèrement
  // de indexCourant : ventes non payées en liquide, écarts de compteur...).
  indexFermeture Decimal?  @db.Decimal(12, 2)
  litresVendus   Decimal?  @db.Decimal(12, 2)
  montantCalcule Decimal?  @db.Decimal(14, 2)

  remises RemiseCaisse[]

  @@unique([cashEntryId, pumpId])
  @@index([cashEntryId])
  @@index([attendantId])
  @@map("pump_readings")
}

// Remise en caisse mid-quart : le pompiste ne doit pas garder plus de
// 100 000 FCFA dans sa "banane" sur la piste de vente — il reverse donc son
// cash à la gérante en plusieurs fois pendant le service. Chaque remise fait
// avancer indexCourant de PumpReading d'autant de litres ((montant + montantTpe)
// / prix au litre du produit de la pompe, au moment de la remise) — le TPE fait
// aussi tourner le compteur physique, au même titre que le cash.
model RemiseCaisse {
  id            String      @id @default(cuid())
  pumpReadingId String
  pumpReading   PumpReading @relation(fields: [pumpReadingId], references: [id])
  montant       Decimal     @db.Decimal(12, 2)
  // TPE propre à cette pompe (ex. TPE-(S1-A)), saisi dans le même geste que le cash remis.
  montantTpe    Decimal     @default(0) @db.Decimal(12, 2)
  // Litres correspondant à (montant + montantTpe) au prix du produit — ce sont eux qui font
  // avancer PumpReading.indexCourant, pas le seul cash.
  litres        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@index([pumpReadingId])
  @@map("remises_caisse")
}

// Versement progressif Gaz en cours de quart, déclaré par le/la responsable
// Gaz du quart. Ces lignes sont agrégées à la clôture pour fixer
// CashEntry.montantGpl.
model VersementProduit {
  id          String    @id @default(cuid())
  cashEntryId String
  cashEntry   CashEntry @relation(fields: [cashEntryId], references: [id])
  attendantId String
  attendant   Attendant @relation(fields: [attendantId], references: [id])
  createdAt   DateTime  @default(now())

  // Conservé pour compatibilité avec les versements TPE historiques saisis avant que le TPE
  // ne devienne propre à chaque pompe (RemiseCaisse.montantTpe) — plus jamais renseigné par
  // les nouvelles saisies, mais toujours sommé à la clôture pour ne pas perdre ces montants.
  montantTpe Decimal @default(0) @db.Decimal(12, 2)

  quantiteGpl125Pleine           Int          @default(0)
  quantiteGpl125Consigne         Int          @default(0)
  quantiteGpl125ConsigneRecharge Int          @default(0)
  quantiteGpl35Pleine            Int          @default(0)
  quantiteGpl35Consigne          Int          @default(0)
  quantiteGpl35ConsigneRecharge  Int          @default(0)
  montantGpl                     Decimal      @default(0) @db.Decimal(12, 2)
  // Mode de paiement de la vente Gaz de cette ligne (CASH par défaut).
  modePaiement                   ModePaiement @default(CASH)

  @@index([cashEntryId])
  @@index([attendantId])
  @@map("versements_produit")
}

// ── Versements (saisie directe par la Gérante — pas de code) ──

model Deposit {
  id              String   @id @default(cuid())
  numeroBordereau String
  bankId          String
  bank            Bank     @relation(fields: [bankId], references: [id])
  stationId       String
  station         Station  @relation(fields: [stationId], references: [id])
  montant         Decimal  @db.Decimal(14, 2)
  createdByUserId String
  createdByUser   User     @relation("DepositsCrees", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  // Certification a posteriori par la Trésorerie des versements au-delà du seuil (non bloquant —
  // contrairement aux commandes, un versement documente un dépôt déjà physiquement effectué en
  // banque, bloquer après coup n'aurait aucun sens). Voir DepositsService.certifier().
  necessiteCertification Boolean   @default(false)
  certifieParUserId      String?
  certifieParUser        User?     @relation("DepositsCertifies", fields: [certifieParUserId], references: [id])
  certifieLe             DateTime?

  denominations DepositDenomination[]

  @@unique([bankId, numeroBordereau])
  @@index([stationId, createdAt])
  @@map("deposits")
}

model DepositDenomination {
  id            String           @id @default(cuid())
  depositId     String
  deposit       Deposit          @relation(fields: [depositId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("deposit_denominations")
}

// ── Stock Carburant / Approvisionnement ──────────────────────

// Relevé manuel (jaugeage) d'un produit à une date donnée, saisi par la gérante.
// Le stock théorique "à jour" (calculé côté service, pas stocké) part du dernier
// jaugeage d'un produit et y retranche les ventes / ajoute les commandes traitées
// survenues depuis — voir StockService.calculerStock().
model Jaugeage {
  id              String       @id @default(cuid())
  stationId       String
  station         Station      @relation(fields: [stationId], references: [id])
  produit         ProduitStock
  // Litres (carburant) ou nombre de bouteilles pleines comptées (Gaz) — même
  // convention d'unité que Commande.quantite.
  quantite        Decimal      @db.Decimal(12, 2)
  dateReleve      DateTime     @default(now())
  commentaire     String?
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([stationId, produit, dateReleve])
  @@map("jaugeages")
}

// Commande de réapprovisionnement passée par la gérante. Visible en lecture seule par la vue
// Réseau dès sa création ; traitée par le rôle GRC (EN_COURS → TRAITEE, irréversible — voir
// ApprovisionnementService.traiter()) ; la réception physique à la station n'est confirmée que
// par la gérante elle-même (TRAITEE → LIVREE, voir ApprovisionnementService.livrer()). Seul ce
// dernier passage compte comme réception de stock, à la date `livreeLe`.
//
// `valeurEstimee` (quantite × prix de vente actuel, indicatif) détermine `necessiteApprobation` à
// la création (seuil SEUIL_APPROBATION_COMMANDE_FCFA) : si vrai, traiter() refuse tant que
// `approuveLe` n'est pas posé par un Administrateur (voir ApprovisionnementService.approuver()).
model Commande {
  id                     String         @id @default(cuid())
  stationId              String
  station                Station        @relation(fields: [stationId], references: [id])
  produit                ProduitStock
  quantite               Decimal        @db.Decimal(12, 2)
  valeurEstimee          Decimal        @default(0) @db.Decimal(14, 2)
  necessiteApprobation   Boolean        @default(false)
  dateLivraisonSouhaitee DateTime
  commentaire            String?
  statut                 StatutCommande @default(EN_COURS)
  createdByUserId        String
  createdByUser          User           @relation("CommandesCreees", fields: [createdByUserId], references: [id])
  createdAt              DateTime       @default(now())
  traiteParUserId        String?
  traiteParUser          User?          @relation("CommandesTraitees", fields: [traiteParUserId], references: [id])
  traiteLe               DateTime?
  livreeParUserId        String?
  livreeParUser          User?          @relation("CommandesLivrees", fields: [livreeParUserId], references: [id])
  livreeLe               DateTime?
  approuveParUserId      String?
  approuveParUser        User?          @relation("CommandesApprouvees", fields: [approuveParUserId], references: [id])
  approuveLe             DateTime?

  @@index([stationId, statut])
  @@index([statut, createdAt])
  @@map("commandes")
}

// Seuil d'alerte par produit, réglé par la gérante elle-même (elle seule connaît la taille
// réelle de ses cuves) — un enregistrement par (station, produit). Lu par StockService pour
// déterminer `enAlerte` sur chaque produit de GET /stock, et agrégé réseau-wide par
// getAlertesReseau() pour la visibilité Réseau/GRC.
model SeuilStock {
  id        String       @id @default(cuid())
  stationId String
  station   Station      @relation(fields: [stationId], references: [id])
  produit   ProduitStock
  seuil     Decimal      @db.Decimal(12, 2)
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([stationId, produit])
  @@map("seuils_stock")
}

// ── Audit (§17 — ajout seul, aucune suppression) ─────────────

model AuditLog {
  id           String         @id @default(cuid())
  date         DateTime       @default(now())
  categorie    CategorieAudit
  action       String
  detail       String
  acteurUserId String?
  acteurLabel  String
  stationId    String?
  station      Station?       @relation(fields: [stationId], references: [id])

  @@index([categorie, date])
  @@index([stationId, date])
  @@map("audit_logs")
}

// ── Journal d'erreurs techniques (réservé à l'Administrateur, pour le
//    diagnostic de bugs — distinct du journal d'audit métier ci-dessus) ──

enum ErrorLogSource {
  BACKEND
  FRONTEND
}

model ErrorLog {
  id         String         @id @default(cuid())
  date       DateTime       @default(now())
  source     ErrorLogSource
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int?
  userId     String?
  userLabel  String?
  userAgent  String?

  @@index([source, date])
  @@map("error_logs")
}
