generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMINISTRATEUR
  TRESORERIE
  CONTROLE_INTERNE
  GERANTE
}

enum Quart {
  MATIN
  SOIR
  NUIT
}

enum StatutCompte {
  ACTIF
  INACTIF
}

enum StatutPompiste {
  ACTIF
  INACTIF
}

enum StatutStation {
  EN_SERVICE
  HORS_SERVICE
}

enum StatutBanque {
  ACTIF
  INACTIF
}

enum DenominationType {
  BILLET
  PIECE
}

enum Produit {
  ESSENCE
  GASOIL
}

enum StatutPompe {
  ACTIF
  INACTIF
}

enum StatutProduit {
  ACTIF
  INACTIF
}

enum CategorieAudit {
  CONNEXION
  ENCAISSEMENT
  VERSEMENT
  UTILISATEUR
  STATION
  BANQUE
  POMPISTE
}

// ── Auth / RBAC ──────────────────────────────────────────────

model User {
  id                String       @id @default(cuid())
  identifiant       String       @unique
  email             String       @unique
  passwordHash      String
  prenom            String
  nom               String
  telephone         String?
  role              Role
  statut            StatutCompte @default(ACTIF)
  stationId         String?
  station           Station?     @relation(fields: [stationId], references: [id])
  mustChangePassword Boolean     @default(false)
  derniereConnexion DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  refreshTokens RefreshToken[]
  deposits      Deposit[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
  @@index([userId])
}

// ── Référentiel ──────────────────────────────────────────────

model Station {
  id      String        @id @default(cuid())
  code    String        @unique
  nom     String
  ville   String
  adresse String
  statut  StatutStation @default(EN_SERVICE)

  quartMatinDebut String @default("06:00")
  quartMatinFin   String @default("14:00")
  quartSoirDebut  String @default("14:00")
  quartSoirFin    String @default("22:00")
  quartNuitDebut  String @default("22:00")
  quartNuitFin    String @default("06:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  attendants  Attendant[]
  pumps       Pump[]
  cashEntries CashEntry[]
  deposits    Deposit[]
  auditLogs   AuditLog[]

  @@map("stations")
}

model Attendant {
  id        String         @id @default(cuid())
  nom       String
  prenom    String
  telephone String
  embauche  DateTime
  quart     Quart
  statut    StatutPompiste @default(ACTIF)
  stationId String
  station   Station        @relation(fields: [stationId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  pumpReadings                 PumpReading[]
  quartsResponsable            CashEntry[]   @relation("ResponsableQuart")
  quartsResponsableGpl         CashEntry[]   @relation("ResponsableGpl")
  quartsResponsableLubrifiants CashEntry[]   @relation("ResponsableLubrifiants")

  @@map("attendants")
  @@index([stationId])
}

// ── Prix réseau (carburant + GPL, un seul enregistrement, identique
// pour toutes les stations — configuré par l'Admin) ───────────────

model PriceConfig {
  id String @id @default(cuid())

  prixLitreEssence Decimal @db.Decimal(10, 2) @default(750)
  prixLitreGasoil  Decimal @db.Decimal(10, 2) @default(700)

  prixGpl125Pleine          Decimal @db.Decimal(10, 2) @default(6000)
  prixGpl125Consigne        Decimal @db.Decimal(10, 2) @default(4500)
  prixGpl125ConsigneRecharge Decimal @db.Decimal(10, 2) @default(1500)
  prixGpl35Pleine           Decimal @db.Decimal(10, 2) @default(15000)
  prixGpl35Consigne         Decimal @db.Decimal(10, 2) @default(11000)
  prixGpl35ConsigneRecharge  Decimal @db.Decimal(10, 2) @default(4000)

  updatedAt DateTime @updatedAt

  @@map("price_config")
}

model Bank {
  id      String       @id @default(cuid())
  code    String       @unique
  nom     String
  type    String
  swift   String
  contact String
  statut  StatutBanque @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]

  @@map("banks")
}

// ── Pompes ────────────────────────────────────────────────────

model Pump {
  id        String      @id @default(cuid())
  stationId String
  station   Station     @relation(fields: [stationId], references: [id])
  code      String
  produit   Produit
  statut    StatutPompe @default(ACTIF)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  pumpReadings PumpReading[]

  @@map("pumps")
  @@unique([stationId, code])
  @@index([stationId])
}

// ── Lubrifiants (catalogue réseau, géré par l'Admin) ──────────

model LubricantProduct {
  id        String        @id @default(cuid())
  nom       String        @unique // "OKAN SX 10W40"
  type      String        // "Huile moteur essence/diesel"
  viscosite String?       // "10W40"
  statut    StatutProduit @default(ACTIF)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  formats LubricantFormat[]

  @@map("lubricant_products")
}

model LubricantFormat {
  id                 String           @id @default(cuid())
  lubricantProductId String
  lubricantProduct   LubricantProduct @relation(fields: [lubricantProductId], references: [id])
  contenance         String           // "1L", "5L", "20L", "200L"
  prixUnitaire       Decimal          @db.Decimal(10, 2)
  statut             StatutProduit    @default(ACTIF)

  ventes LubricantSale[]

  @@map("lubricant_formats")
  @@unique([lubricantProductId, contenance])
}

// ── Encaissements (un enregistrement par quart, station et date) ─

model CashEntry {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  quart     Quart
  date      DateTime @default(now())

  responsableQuartId       String
  responsableQuart         Attendant @relation("ResponsableQuart", fields: [responsableQuartId], references: [id])
  responsableGplId         String
  responsableGpl           Attendant @relation("ResponsableGpl", fields: [responsableGplId], references: [id])
  responsableLubrifiantsId String
  responsableLubrifiants   Attendant @relation("ResponsableLubrifiants", fields: [responsableLubrifiantsId], references: [id])

  totalBillets Decimal @db.Decimal(14, 2)
  totalPieces  Decimal @db.Decimal(14, 2)
  montant      Decimal @db.Decimal(14, 2) // cash physique (billetage) — seul montant réellement versable en banque

  montantTpe    Decimal @db.Decimal(14, 2) @default(0) // ventes carte (TPE), déjà bancarisées, jamais physiques
  montantGlobal Decimal @db.Decimal(14, 2) @default(0) // montant + montantTpe — sert de référence pour l'écart

  quantiteGpl125Pleine          Int @default(0)
  quantiteGpl125Consigne        Int @default(0)
  quantiteGpl125ConsigneRecharge Int @default(0)
  quantiteGpl35Pleine           Int @default(0)
  quantiteGpl35Consigne         Int @default(0)
  quantiteGpl35ConsigneRecharge  Int @default(0)
  montantGpl                    Decimal @db.Decimal(14, 2)

  montantCarburant   Decimal @db.Decimal(14, 2)
  montantLubrifiants Decimal @db.Decimal(14, 2) @default(0)
  ecart              Decimal @db.Decimal(14, 2)

  denominations  Denomination[]
  pumpReadings   PumpReading[]
  lubricantSales LubricantSale[]

  @@map("cash_entries")
  @@unique([stationId, quart, date])
  @@index([stationId, date])
}

model Denomination {
  id            String           @id @default(cuid())
  cashEntryId   String
  cashEntry     CashEntry        @relation(fields: [cashEntryId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("denominations")
}

model PumpReading {
  id             String    @id @default(cuid())
  cashEntryId    String
  cashEntry      CashEntry @relation(fields: [cashEntryId], references: [id])
  attendantId    String
  attendant      Attendant @relation(fields: [attendantId], references: [id])
  pumpId         String
  pump           Pump      @relation(fields: [pumpId], references: [id])
  indexOuverture Decimal   @db.Decimal(12, 2)
  indexFermeture Decimal   @db.Decimal(12, 2)
  litresVendus   Decimal   @db.Decimal(12, 2)
  montantCalcule Decimal   @db.Decimal(14, 2)

  @@map("pump_readings")
  @@unique([cashEntryId, pumpId])
  @@index([cashEntryId])
  @@index([attendantId])
}

model LubricantSale {
  id                String          @id @default(cuid())
  cashEntryId       String
  cashEntry         CashEntry       @relation(fields: [cashEntryId], references: [id])
  lubricantFormatId String
  lubricantFormat   LubricantFormat @relation(fields: [lubricantFormatId], references: [id])
  quantite          Int
  montantCalcule    Decimal         @db.Decimal(14, 2)

  @@map("lubricant_sales")
  @@unique([cashEntryId, lubricantFormatId])
  @@index([cashEntryId])
}

// ── Versements (saisie directe par la Gérante — pas de code) ──

model Deposit {
  id              String   @id @default(cuid())
  numeroBordereau String
  bankId          String
  bank            Bank     @relation(fields: [bankId], references: [id])
  stationId       String
  station         Station  @relation(fields: [stationId], references: [id])
  montant         Decimal  @db.Decimal(14, 2)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  denominations DepositDenomination[]

  @@map("deposits")
  @@unique([bankId, numeroBordereau])
  @@index([stationId, createdAt])
}

model DepositDenomination {
  id            String           @id @default(cuid())
  depositId     String
  deposit       Deposit          @relation(fields: [depositId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("deposit_denominations")
}

// ── Audit (§17 — ajout seul, aucune suppression) ─────────────

model AuditLog {
  id           String         @id @default(cuid())
  date         DateTime       @default(now())
  categorie    CategorieAudit
  action       String
  detail       String
  acteurUserId String?
  acteurLabel  String
  stationId    String?
  station      Station?       @relation(fields: [stationId], references: [id])

  @@map("audit_logs")
  @@index([categorie, date])
  @@index([stationId, date])
}

// ── Journal d'erreurs techniques (réservé à l'Administrateur, pour le
//    diagnostic de bugs — distinct du journal d'audit métier ci-dessus) ──

enum ErrorLogSource {
  BACKEND
  FRONTEND
}

model ErrorLog {
  id         String         @id @default(cuid())
  date       DateTime       @default(now())
  source     ErrorLogSource
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int?
  userId     String?
  userLabel  String?
  userAgent  String?

  @@map("error_logs")
  @@index([source, date])
}
