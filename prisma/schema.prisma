generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  ADMINISTRATEUR
  TRESORERIE
  CONTROLE_INTERNE
  GERANTE
}

enum Quart {
  MATIN
  SOIR
  NUIT
}

enum StatutCompte {
  ACTIF
  INACTIF
}

enum StatutPompiste {
  ACTIF
  INACTIF
}

enum StatutStation {
  EN_SERVICE
  HORS_SERVICE
}

enum StatutBanque {
  ACTIF
  INACTIF
}

enum DenominationType {
  BILLET
  PIECE
}

enum Produit {
  ESSENCE
  GASOIL
  PETROLE
}

enum StatutPompe {
  ACTIF
  INACTIF
}

enum StatutProduit {
  ACTIF
  INACTIF
}

// Un quart commence EN_COURS (pompistes + index d'ouverture connus) : le
// pompiste peut y adosser plusieurs remises en caisse pendant le service.
// Il passe à CLOTURE quand la gérante saisit les index de fermeture réels
// et le reste des données du quart (billetage, TPE, GPL, lubrifiants).
enum StatutQuart {
  EN_COURS
  CLOTURE
}

enum CategorieAudit {
  CONNEXION
  ENCAISSEMENT
  VERSEMENT
  UTILISATEUR
  STATION
  BANQUE
  POMPISTE
}

// ── Auth / RBAC ──────────────────────────────────────────────

model User {
  id                String       @id @default(cuid())
  identifiant       String       @unique
  email             String       @unique
  passwordHash      String
  prenom            String
  nom               String
  telephone         String?
  role              Role
  statut            StatutCompte @default(ACTIF)
  stationId         String?
  station           Station?     @relation(fields: [stationId], references: [id])
  mustChangePassword Boolean     @default(false)
  derniereConnexion DateTime?
  // Verrouillage temporaire après plusieurs échecs de connexion consécutifs (cf.
  // AuthService.login) — protège contre le brute-force distribué sur un compte
  // précis, que le débit-limitage par IP (@Throttle sur /auth/login) ne couvre pas.
  failedLoginAttempts Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  refreshTokens RefreshToken[]
  deposits      Deposit[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
  @@index([userId])
}

// ── Référentiel ──────────────────────────────────────────────

model Station {
  id      String        @id @default(cuid())
  code    String        @unique
  nom     String
  ville   String
  adresse String
  statut  StatutStation @default(EN_SERVICE)

  quartMatinDebut String @default("06:00")
  quartMatinFin   String @default("14:00")
  quartSoirDebut  String @default("14:00")
  quartSoirFin    String @default("22:00")
  quartNuitDebut  String @default("22:00")
  quartNuitFin    String @default("06:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  attendants    Attendant[]
  pumps         Pump[]
  distributeurs Distributeur[]
  cashEntries   CashEntry[]
  deposits      Deposit[]
  auditLogs     AuditLog[]

  @@map("stations")
}

// Îlot physique regroupant plusieurs pompes (généralement jusqu'à 4 : essence,
// gasoil, pétrole). Affecter un distributeur à un pompiste à l'ouverture d'un
// quart lui assigne d'un coup toutes les pompes actives de ce distributeur.
model Distributeur {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pumps Pump[]

  @@map("distributeurs")
  @@unique([stationId, nom])
  @@index([stationId])
}

model Attendant {
  id        String         @id @default(cuid())
  nom       String
  prenom    String
  telephone String
  embauche  DateTime
  quart     Quart
  statut    StatutPompiste @default(ACTIF)
  stationId String
  station   Station        @relation(fields: [stationId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  pumpReadings                 PumpReading[]
  quartsResponsable            CashEntry[]   @relation("ResponsableQuart")
  quartsResponsableGpl         CashEntry[]   @relation("ResponsableGpl")
  quartsResponsableLubrifiants CashEntry[]   @relation("ResponsableLubrifiants")
  versements                   VersementProduit[]

  @@map("attendants")
  @@index([stationId])
}

// ── Prix réseau (carburant + GPL, un seul enregistrement, identique
// pour toutes les stations — configuré par l'Admin) ───────────────

model PriceConfig {
  id String @id @default(cuid())

  prixLitreEssence Decimal @db.Decimal(10, 2) @default(750)
  prixLitreGasoil  Decimal @db.Decimal(10, 2) @default(700)
  prixLitrePetrole Decimal @db.Decimal(10, 2) @default(650)

  prixGpl125Pleine          Decimal @db.Decimal(10, 2) @default(6000)
  prixGpl125Consigne        Decimal @db.Decimal(10, 2) @default(4500)
  prixGpl125ConsigneRecharge Decimal @db.Decimal(10, 2) @default(1500)
  prixGpl35Pleine           Decimal @db.Decimal(10, 2) @default(15000)
  prixGpl35Consigne         Decimal @db.Decimal(10, 2) @default(11000)
  prixGpl35ConsigneRecharge  Decimal @db.Decimal(10, 2) @default(4000)

  updatedAt DateTime @updatedAt

  @@map("price_config")
}

model Bank {
  id      String       @id @default(cuid())
  code    String       @unique
  nom     String
  type    String
  swift   String
  contact String
  statut  StatutBanque @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]

  @@map("banks")
}

// ── Pompes ────────────────────────────────────────────────────

model Pump {
  id             String        @id @default(cuid())
  stationId      String
  station        Station       @relation(fields: [stationId], references: [id])
  distributeurId String
  distributeur   Distributeur @relation(fields: [distributeurId], references: [id])
  code           String
  produit        Produit
  statut         StatutPompe   @default(ACTIF)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  pumpReadings PumpReading[]

  @@map("pumps")
  @@unique([stationId, code])
  @@index([distributeurId])
  @@index([stationId])
}

// ── Lubrifiants (catalogue réseau, géré par l'Admin) ──────────

model LubricantProduct {
  id        String        @id @default(cuid())
  nom       String        @unique // "OKAN SX 10W40"
  type      String        // "Huile moteur essence/diesel"
  viscosite String?       // "10W40"
  statut    StatutProduit @default(ACTIF)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  formats LubricantFormat[]

  @@map("lubricant_products")
}

model LubricantFormat {
  id                 String           @id @default(cuid())
  lubricantProductId String
  lubricantProduct   LubricantProduct @relation(fields: [lubricantProductId], references: [id])
  contenance         String           // "1L", "5L", "20L", "200L"
  prixUnitaire       Decimal          @db.Decimal(10, 2)
  statut             StatutProduit    @default(ACTIF)

  ventes           LubricantSale[]
  ventesVersements VersementLubrifiantSale[]

  @@map("lubricant_formats")
  @@unique([lubricantProductId, contenance])
}

// ── Encaissements (un enregistrement par quart, station et date) ─

model CashEntry {
  id        String      @id @default(cuid())
  stationId String
  station   Station     @relation(fields: [stationId], references: [id])
  quart     Quart
  date      DateTime    @default(now())
  statut    StatutQuart @default(EN_COURS)

  responsableQuartId       String
  responsableQuart         Attendant @relation("ResponsableQuart", fields: [responsableQuartId], references: [id])
  responsableGplId         String
  responsableGpl           Attendant @relation("ResponsableGpl", fields: [responsableGplId], references: [id])
  responsableLubrifiantsId String
  responsableLubrifiants   Attendant @relation("ResponsableLubrifiants", fields: [responsableLubrifiantsId], references: [id])

  // Tous les champs financiers ci-dessous valent 0 tant que statut = EN_COURS
  // (aucun versement n'est encore agrégé) — ils sont figés à la clôture du
  // quart, à partir de la somme des remises et des VersementProduit reçus
  // pendant le quart (voir CashEntriesService.cloturer).
  // totalBillets/totalPieces : comptage optionnel de vérification saisi par la
  // gérante à la clôture (Denomination) — n'alimente plus `montant`, seulement
  // une alerte si la somme diffère de `montant`.
  totalBillets Decimal @db.Decimal(14, 2) @default(0)
  totalPieces  Decimal @db.Decimal(14, 2) @default(0)
  montant      Decimal @db.Decimal(14, 2) @default(0) // cash physique = somme des remises en caisse reçues pendant le quart

  montantTpe    Decimal @db.Decimal(14, 2) @default(0) // ventes carte (TPE), déjà bancarisées, jamais physiques
  montantGlobal Decimal @db.Decimal(14, 2) @default(0) // montant + montantTpe + montantGpl + montantLubrifiants — sert de référence pour l'écart

  quantiteGpl125Pleine          Int @default(0)
  quantiteGpl125Consigne        Int @default(0)
  quantiteGpl125ConsigneRecharge Int @default(0)
  quantiteGpl35Pleine           Int @default(0)
  quantiteGpl35Consigne         Int @default(0)
  quantiteGpl35ConsigneRecharge  Int @default(0)
  montantGpl                    Decimal @db.Decimal(14, 2) @default(0)

  montantCarburant   Decimal @db.Decimal(14, 2) @default(0)
  montantLubrifiants Decimal @db.Decimal(14, 2) @default(0)
  ecart              Decimal @db.Decimal(14, 2) @default(0)

  denominations  Denomination[]
  pumpReadings   PumpReading[]
  lubricantSales LubricantSale[]
  versements     VersementProduit[]

  @@map("cash_entries")
  @@unique([stationId, quart, date])
  @@index([stationId, date])
}

model Denomination {
  id            String           @id @default(cuid())
  cashEntryId   String
  cashEntry     CashEntry        @relation(fields: [cashEntryId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("denominations")
}

model PumpReading {
  id             String    @id @default(cuid())
  cashEntryId    String
  cashEntry      CashEntry @relation(fields: [cashEntryId], references: [id])
  attendantId    String
  attendant      Attendant @relation(fields: [attendantId], references: [id])
  pumpId         String
  pump           Pump      @relation(fields: [pumpId], references: [id])
  indexOuverture Decimal   @db.Decimal(12, 2)
  // Estimation vivante = indexOuverture + Σ(litres correspondant au cash ET au TPE de chaque
  // remise déjà enregistrée — un client qui paie par carte fait aussi tourner le compteur) —
  // mise à jour à chaque remise, tant que le quart est EN_COURS.
  indexCourant   Decimal?  @db.Decimal(12, 2)
  // Relevé réel du compteur, saisi par la gérante à la clôture du quart —
  // seule valeur qui sert au calcul financier final (peut différer légèrement
  // de indexCourant : ventes non payées en liquide, écarts de compteur...).
  indexFermeture Decimal?  @db.Decimal(12, 2)
  litresVendus   Decimal?  @db.Decimal(12, 2)
  montantCalcule Decimal?  @db.Decimal(14, 2)

  remises RemiseCaisse[]

  @@map("pump_readings")
  @@unique([cashEntryId, pumpId])
  @@index([cashEntryId])
  @@index([attendantId])
}

// Remise en caisse mid-quart : le pompiste ne doit pas garder plus de
// 100 000 FCFA dans sa "banane" sur la piste de vente — il reverse donc son
// cash à la gérante en plusieurs fois pendant le service. Chaque remise fait
// avancer indexCourant de PumpReading d'autant de litres ((montant + montantTpe)
// / prix au litre du produit de la pompe, au moment de la remise) — le TPE fait
// aussi tourner le compteur physique, au même titre que le cash.
model RemiseCaisse {
  id            String      @id @default(cuid())
  pumpReadingId String
  pumpReading   PumpReading @relation(fields: [pumpReadingId], references: [id])
  montant       Decimal     @db.Decimal(12, 2)
  // TPE propre à cette pompe (ex. TPE-(S1-A)), saisi dans le même geste que le cash remis.
  montantTpe    Decimal     @db.Decimal(12, 2) @default(0)
  // Litres correspondant à (montant + montantTpe) au prix du produit — ce sont eux qui font
  // avancer PumpReading.indexCourant, pas le seul cash.
  litres        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@map("remises_caisse")
  @@index([pumpReadingId])
}

// Versement progressif Gaz/Lubrifiants en cours de quart, déclaré par le/la
// responsable Gaz/Lubrifiants du quart. Ces lignes sont agrégées à la
// clôture pour fixer CashEntry.montantGpl/montantLubrifiants.
model VersementProduit {
  id          String    @id @default(cuid())
  cashEntryId String
  cashEntry   CashEntry @relation(fields: [cashEntryId], references: [id])
  attendantId String
  attendant   Attendant @relation(fields: [attendantId], references: [id])
  createdAt   DateTime  @default(now())

  // Conservé pour compatibilité avec les versements TPE historiques saisis avant que le TPE
  // ne devienne propre à chaque pompe (RemiseCaisse.montantTpe) — plus jamais renseigné par
  // les nouvelles saisies, mais toujours sommé à la clôture pour ne pas perdre ces montants.
  montantTpe Decimal @db.Decimal(12, 2) @default(0)

  quantiteGpl125Pleine          Int @default(0)
  quantiteGpl125Consigne        Int @default(0)
  quantiteGpl125ConsigneRecharge Int @default(0)
  quantiteGpl35Pleine           Int @default(0)
  quantiteGpl35Consigne         Int @default(0)
  quantiteGpl35ConsigneRecharge  Int @default(0)
  montantGpl                    Decimal @db.Decimal(12, 2) @default(0)

  lubricantSales VersementLubrifiantSale[]

  @@map("versements_produit")
  @@index([cashEntryId])
  @@index([attendantId])
}

model VersementLubrifiantSale {
  id                String           @id @default(cuid())
  versementId       String
  versement         VersementProduit @relation(fields: [versementId], references: [id])
  lubricantFormatId String
  lubricantFormat   LubricantFormat  @relation(fields: [lubricantFormatId], references: [id])
  quantite          Int
  montantCalcule    Decimal          @db.Decimal(14, 2)

  @@map("versement_lubricant_sales")
  @@index([versementId])
}

model LubricantSale {
  id                String          @id @default(cuid())
  cashEntryId       String
  cashEntry         CashEntry       @relation(fields: [cashEntryId], references: [id])
  lubricantFormatId String
  lubricantFormat   LubricantFormat @relation(fields: [lubricantFormatId], references: [id])
  quantite          Int
  montantCalcule    Decimal         @db.Decimal(14, 2)

  @@map("lubricant_sales")
  @@unique([cashEntryId, lubricantFormatId])
  @@index([cashEntryId])
}

// ── Versements (saisie directe par la Gérante — pas de code) ──

model Deposit {
  id              String   @id @default(cuid())
  numeroBordereau String
  bankId          String
  bank            Bank     @relation(fields: [bankId], references: [id])
  stationId       String
  station         Station  @relation(fields: [stationId], references: [id])
  montant         Decimal  @db.Decimal(14, 2)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  denominations DepositDenomination[]

  @@map("deposits")
  @@unique([bankId, numeroBordereau])
  @@index([stationId, createdAt])
}

model DepositDenomination {
  id            String           @id @default(cuid())
  depositId     String
  deposit       Deposit          @relation(fields: [depositId], references: [id])
  type          DenominationType
  valeurFaciale Decimal          @db.Decimal(10, 2)
  quantite      Int
  sousTotal     Decimal          @db.Decimal(14, 2)

  @@map("deposit_denominations")
}

// ── Audit (§17 — ajout seul, aucune suppression) ─────────────

model AuditLog {
  id           String         @id @default(cuid())
  date         DateTime       @default(now())
  categorie    CategorieAudit
  action       String
  detail       String
  acteurUserId String?
  acteurLabel  String
  stationId    String?
  station      Station?       @relation(fields: [stationId], references: [id])

  @@map("audit_logs")
  @@index([categorie, date])
  @@index([stationId, date])
}

// ── Journal d'erreurs techniques (réservé à l'Administrateur, pour le
//    diagnostic de bugs — distinct du journal d'audit métier ci-dessus) ──

enum ErrorLogSource {
  BACKEND
  FRONTEND
}

model ErrorLog {
  id         String         @id @default(cuid())
  date       DateTime       @default(now())
  source     ErrorLogSource
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int?
  userId     String?
  userLabel  String?
  userAgent  String?

  @@map("error_logs")
  @@index([source, date])
}
